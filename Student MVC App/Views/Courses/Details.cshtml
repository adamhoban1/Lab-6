@model Student_Class_Library.Course

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Course</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.department)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.department)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.lecturer)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.lecturer)
        </dd>
    </dl>
</div>
<h4>Enrolled Students</h4>
<ul>
    @foreach (var student in Model.StudentCourses.Select(sc => sc.Student))
    {
        <li>
            <a asp-controller="Students" asp-action="Details" asp-route-id="@student.Id">
                @student.Name
            </a>
        </li>
    }
</ul>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
